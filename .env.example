# Copy this file to .env and fill in the values. .env is git-ignored.
#
# Any OpenAI-compatible server works. For Ollama running on your machine,
# reached from inside Docker:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=qwen2.5:3b
#   LLM_API_KEY=ollama            (Ollama ignores it, but the client needs something)
# For OpenAI itself, leave LLM_BASE_URL empty and use a real key.
#
# With no LLM_API_KEY, the app uses the keyword-rules fake extractor instead.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
